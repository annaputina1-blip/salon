# Server binding
HOST=127.0.0.1
PORT=4173

# Login and password for admin panel
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Session signing secret (change this too)
ADMIN_SESSION_SECRET=

# Telegram notifications for new requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Telegram bot booking schedule
BOOKING_WORKDAY_START=09:00
BOOKING_WORKDAY_END=20:00
BOOKING_DAYS_AHEAD=14
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_TIMEZONE_OFFSET=+03:00
APPOINTMENT_REMINDER_HOURS=3
APPOINTMENT_REMINDER_CHECK_MS=60000
REVIEW_REQUEST_DELAY_MINUTES=15
PUBLIC_SITE_URL=https://massag-yablonovskiy.ru
REVIEW_URL=https://massag-yablonovskiy.ru/#reviews

# SQLite database file
DATABASE_FILE=data/salon.sqlite

# Make.com webhook for new requests
MAKE_WEBHOOK_URL=

# Optional proxy for Telegram API (example: http://login:password@host:port)
HTTPS_PROXY=
