# Server binding
HOST=127.0.0.1
PORT=4173

# Login and password for admin panel
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Session signing secret (change this too)
ADMIN_SESSION_SECRET=very_secret_key_123

# Telegram notifications for new requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram bot booking schedule
BOOKING_WORKDAY_START=09:00
BOOKING_WORKDAY_END=20:00
BOOKING_DAYS_AHEAD=14
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_TIMEZONE_OFFSET=+03:00

# Make.com webhook for new requests
MAKE_WEBHOOK_URL=

# Optional proxy for Telegram API (example: http://login:password@host:port)
HTTPS_PROXY=
